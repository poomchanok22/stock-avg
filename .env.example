# Database — SQLite (local dev)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Exchange Rate API (free, no key needed)
# Uses: https://open.er-api.com/v6/latest/USD
# No API key required for basic rates

# ---- For Vercel deployment (replace DATABASE_URL above) ----
# Option A: Neon PostgreSQL (free tier)
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
# Option B: Turso (SQLite on edge, free tier)
